{
  "name": "chatflow-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official multilingual website and documentation platform for chatflow-agent",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "fumadocs-mdx && next build --webpack",
    "start": "next start -p 3001",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:i18n && pnpm test",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.7.1",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.8",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.1",
    "prettier": "^3.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
